ConvertFrom-StringData @'
# English strings
CmdletBindingAttributeMissing = A [CmdletBinding()] attribute must be the first attribute above each parameter block and be on its own line See https://github.com/PowerShell/DscResources/blob/master/StyleGuidelines.md#correct-format-for-parameter-block
CmdletBindingAttributeLowerCase = The [CmdletBinding()] attribute must start with an upper case 'C'. See https://github.com/PowerShell/DscResources/blob/master/StyleGuidelines.md#correct-format-for-parameter-block
ParameterNotPascalCase = Parameters should use PascalCase. See https://github.com/PowerShell/DscResources/blob/master/StyleGuidelines.md#parameter-names-use-pascal-case
ParameterAttributeNotPascalCase = Parameters Attributes should use PascalCase. See https://github.com/PowerShell/DscResources/blob/master/StyleGuidelines.md#parameter-names-use-pascal-case
ParameterInScriptNotPascalCase = Parameters should use PascalCase. See https://github.com/PowerShell/DscResources/blob/master/StyleGuidelines.md#parameter-names-use-pascal-case
VariableNotCamelCase = Variables should use camelCase. See https://github.com/PowerShell/DscResources/blob/master/StyleGuidelines.md#variable-names-use-camel-case
'@
